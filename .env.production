# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# 
# IMPORTANT: Never commit this file with real values to version control.
# Use a secure configuration management system or CI/CD secrets.

# Environment
ENVIRONMENT=production
DEBUG=false
TESTING=false

# ─────────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────────

# CHANGE THESE IN PRODUCTION - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-random-key-of-at-least-32-characters
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-key-of-at-least-32-characters

# CORS origins - adjust based on your deployment domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=5000

# Server should be behind a reverse proxy (Nginx/Apache) in production
WORKERS=4
WORKER_CLASS=sync
WORKER_TIMEOUT=120
KEEPALIVE=5

# ─────────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

# Supported: 'json' | 'sqlite' | 'mongodb'
# Recommended for production: 'mongodb' or 'sqlite'
DB_DRIVER=mongodb

# JSON adapter (if DB_DRIVER=json)
JSON_BASE_DIR=static

# SQLite adapter (if DB_DRIVER=sqlite)
SQLITE_PATH=/var/lib/smartapp/smart_attendance.db

# MongoDB adapter (if DB_DRIVER=mongodb) - RECOMMENDED
MONGODB_URI=mongodb://username:password@mongodb-host:27017/?authSource=admin&ssl=true
MONGODB_DATABASE=smart_attendance_prod

# ─────────────────────────────────────────────────────────────────────────────────
# FACE RECOGNITION & DETECTION
# ─────────────────────────────────────────────────────────────────────────────────

# Face recognition tolerance (0.5-0.75 recommended)
FACE_RECOGNITION_TOLERANCE=0.65

# Face detection model: 'hog' (faster) | 'cnn' (slower but more accurate)
# In production, consider GPU-accelerated deployment with CNN
FACE_DETECTION_MODEL=hog

# Distance thresholds for face flagging
FACE_FLAGGED_DISTANCE_MIN=0.50
FACE_FLAGGED_DISTANCE_MAX=0.65

# ─────────────────────────────────────────────────────────────────────────────────
# GEOFENCE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

# Default geofence radius in meters
DEFAULT_GEOFENCE_RADIUS_M=40

# ─────────────────────────────────────────────────────────────────────────────────
# ATTENDANCE ENGINE
# ─────────────────────────────────────────────────────────────────────────────────

# Timeout for attendance verification steps (seconds)
ATTENDANCE_STEP_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
# Log file path - use absolute path or environment-specific path
LOG_FILE=/var/log/smartapp/smartapp.log
# Alternative: LOG_FILE=/opt/smartapp/logs/smartapp.log

# ─────────────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────────────

EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_TOKEN=your-expo-push-token-here

# ─────────────────────────────────────────────────────────────────────────────────
# FILE UPLOAD & STORAGE
# ─────────────────────────────────────────────────────────────────────────────────

# Max file upload size (bytes) - default 50MB
MAX_UPLOAD_SIZE=52428800

# Static files storage location
STATIC_FILES_PATH=/var/lib/smartapp/static

# ─────────────────────────────────────────────────────────────────────────────────
# PERFORMANCE & CACHING
# ─────────────────────────────────────────────────────────────────────────────────

# Cache expiration in seconds
CACHE_EXPIRATION=3600

# Session timeout in seconds
SESSION_TIMEOUT=3600

# ─────────────────────────────────────────────────────────────────────────────────
# BACKUP & MAINTENANCE
# ─────────────────────────────────────────────────────────────────────────────────

# Enable automatic backups
ENABLE_BACKUPS=true

# Backup location
BACKUP_PATH=/var/lib/smartapp/backups

# Backup frequency (daily, weekly, monthly)
BACKUP_FREQUENCY=daily
