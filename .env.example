# ═══════════════════════════════════════════════════════════════════════════════
# SmartApp Environment Variables Example
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
#
# For Render deployment, set these in the Render dashboard Environment tab.

# ─────────────────────────────────────────────────────────────────────────────
# Flask Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Environment (development/production)
ENVIRONMENT=production

# Secret keys (generate with: openssl rand -hex 32)
SECRET_KEY=your-32-character-secret-key-here
JWT_SECRET_KEY=your-32-character-jwt-secret-key-here

# Debug mode (False for production)
DEBUG=False

# Flask environment
FLASK_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Database driver (json/sqlite/mongodb/postgresql/mysql)
DB_DRIVER=mysql

# MySQL connection (IHS cPanel - External Database)
DB_HOST=your-ihs-cpanel-mysql-host.com
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=3306

# Alternative: Local MySQL container (uncomment if using local MySQL)
# DB_HOST=db
# DB_NAME=smart_attendance
# DB_USER=smartapp_user
# DB_PASSWORD=smartapp_pass
# MYSQL_ROOT_PASSWORD=rootpass

# Alternative: MongoDB (if using MongoDB instead)
# DB_DRIVER=mongodb
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
# MONGODB_DATABASE=smart_attendance_prod

# Alternative: SQLite (for development/testing)
# DB_DRIVER=sqlite
# SQLITE_PATH=smart_attendance.db

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://smartapp-backend.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# Face Recognition
# ─────────────────────────────────────────────────────────────────────────────

# Face recognition tolerance (0.0-1.0, lower = stricter)
FACE_RECOGNITION_TOLERANCE=0.65

# Face detection model (hog/cnn)
FACE_DETECTION_MODEL=hog

# Flagged distance thresholds
FACE_FLAGGED_DISTANCE_MIN=0.50
FACE_FLAGGED_DISTANCE_MAX=0.65

# ─────────────────────────────────────────────────────────────────────────────
# Geofence Settings
# ─────────────────────────────────────────────────────────────────────────────

# Default geofence radius in meters
DEFAULT_GEOFENCE_RADIUS_M=40

# ─────────────────────────────────────────────────────────────────────────────
# Attendance Engine
# ─────────────────────────────────────────────────────────────────────────────

# Step timeout in seconds
ATTENDANCE_STEP_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Log file path (leave empty for stdout)
LOG_FILE=

# ─────────────────────────────────────────────────────────────────────────────
# Server (usually handled by Render/gunicorn)
# ─────────────────────────────────────────────────────────────────────────────

# Host (0.0.0.0 for production)
HOST=0.0.0.0

# Port (set by Render automatically)
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# Legacy/Development Settings (may not be used)
# ─────────────────────────────────────────────────────────────────────────────

# Redis (for caching/sessions) - not currently used
# REDIS_URL=redis://localhost:6379/0

# MinIO/S3 Storage (for face images) - not currently used
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=attendance-faces

# JSON Database (fallback)
# JSON_BASE_DIR=static
