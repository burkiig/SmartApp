# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
PORT=5000
DEBUG=true
HOST=0.0.0.0

# Database Configuration (only one active: PostgreSQL > MongoDB > JSON)
# PostgreSQL
USE_POSTGRESQL=false
DB_URL=postgresql://user:password@localhost:5432/smart_attendance
DATABASE_URL=postgresql://user:password@localhost:5432/smart_attendance

# MongoDB
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=smart_attendance
USE_MONGODB=false

# Redis (for caching/sessions)
REDIS_URL=redis://localhost:6379/0

# MinIO/S3 Storage (for face images)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=attendance-faces

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Face Recognition Settings
FACE_RECOGNITION_TOLERANCE=0.6
FACE_DETECTION_MODEL=hog

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# JSON Database (fallback)
JSON_BASE_DIR=static
